# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Crash log files
crash.log
crash.*.log

# Ignore override files as they are used to override resources locally 
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraform.tfstate.lock.info
.terraformrc
terraform.rc
